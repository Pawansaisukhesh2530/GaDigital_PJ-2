# ============================================================
#  Nivi Homes - Git ignore (production)
# ============================================================

# --- Runtime / generated files (never commit) ---
data/sessions/
data/logs/
*.log
mail.log

# SQLite write-ahead log & shared-memory (transient; the .sqlite is committed)
*.sqlite-wal
*.sqlite-shm
data/nivihomes.sqlite-wal
data/nivihomes.sqlite-shm

# --- Dependencies ---
/vendor/
node_modules/

# --- Environment / secrets ---
.env
.env.*

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
